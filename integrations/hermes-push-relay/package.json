{
  "name": "hermes-push-relay",
  "version": "0.1.0",
  "private": true,
  "description": "Content-blind APNs push relay for Hermes Fleet (Cloudflare Worker).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {

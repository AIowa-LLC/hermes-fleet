<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>Hermes Fleet uses the camera only to scan your gateway's pairing QR code. No photos or video are saved.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Hermes Fleet uses Face ID to unlock the app and protect your fleet conversations.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Hermes Fleet connects to your Hermes gateway on the local network.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Hermes Fleet transcribes your voice on-device so you can speak prompts instead of typing. Only the recognized text is sent to your gateway.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Hermes Fleet uses the microphone to transcribe your spoken prompts on this device.</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.aiowa.hermesfleet.dev.conversation</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>hermes-fleet-dev</string>
			</array>
		</dict>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>FleetDevBuild</key>
	<true/>
	<key>FleetKeychainNamespace</key>
	<string>com.aiowa.hermesfleet.dev</string>
	<key>FleetConversationURLScheme</key>
	<string>hermes-fleet-dev</string>
	<key>FleetCacheDirectory</key>
	<string>HermesFleetDevCache</string>
	<key>FleetDevSourceSHA</key>
	<string>$(FLEET_DEV_SOURCE_SHA)</string>
</dict>
</plist>

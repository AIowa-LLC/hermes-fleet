--- /dev/null
+++ b/hermes_cli/dashboard_auth/fleet_pairing_routes.py
@@ -0,0 +1,589 @@
+"""HTTP routes for Hermes Fleet device pairing. See ``fleet_devices`` for the threat model.
+
+Owner-only (a verified, NON-device dashboard session; refused for a paired device so a phone can
+never mint invitations for, or revoke, other devices):
+
+  POST   /api/fleet/pairing/invitations         create a short-lived single-use invitation
+  GET    /api/fleet/pairing/invitations         list pending invitations (no secrets)
+  DELETE /api/fleet/pairing/invitations/{id}    cancel a pending invitation
+  GET    /api/fleet/devices                     list paired devices
+  DELETE /api/fleet/devices/{id}                revoke a paired device
+
+Public, each authenticated by a secret in the request body (never in a URL, never logged):
+
+  POST /api/fleet/pairing/preview   inspect an invitation WITHOUT consuming it
+  POST /api/fleet/pairing/redeem    consume it and receive the device credential (once)
+  POST /auth/device-login           exchange a device credential for a session (cookie)
+  POST /auth/device-revoke          a device revokes itself
+
+  GET  /pair                                   secret-free landing page for a link opened in a browser
+  GET  /.well-known/apple-app-site-association Universal Links association (when configured)
+
+Every pairing route refuses unless the dashboard auth gate is engaged: pairing is for gateways
+reachable from the phone, and it must never open a path around the loopback session token.
+"""
+from __future__ import annotations
+
+import html
+import ipaddress
+import logging
+import secrets
+import threading
+import time
+from collections import OrderedDict, deque
+from pathlib import Path
+from typing import Any, Optional
+from urllib.parse import urlparse
+
+from fastapi import APIRouter, Request
+from fastapi.responses import HTMLResponse, JSONResponse
+from pydantic import BaseModel, ConfigDict, Field
+
+from hermes_cli.dashboard_auth import fleet_devices as devices
+from hermes_cli.dashboard_auth.audit import AuditEvent, audit_log
+from hermes_cli.dashboard_auth.cookies import detect_https, set_session_cookies
+from hermes_cli.dashboard_auth.fleet_device_provider import PROVIDER_NAME, FleetDeviceProvider
+from hermes_cli.dashboard_auth.prefix import prefix_from_request, resolve_public_url
+from hermes_cli.dashboard_auth.request_utils import access_token_max_age, client_ip
+
+_log = logging.getLogger(__name__)
+
+router = APIRouter()
+
+_NO_STORE = {"Cache-Control": "no-store, no-cache, must-revalidate", "Pragma": "no-cache"}
+
+_STATUS_FOR_CODE = {
+    "invalid": 404,
+    "expired": 410,
+    "cancelled": 410,
+    "already_used": 409,
+    "too_many_pending": 429,
+    "invalid_credential": 401,
+    "invalid_request": 400,
+}
+
+#: Human summary of each grantable scope, shown by the phone before the owner confirms.
+SCOPE_SUMMARIES = {
+    devices.SCOPE_OPERATOR: (
+        "Chat with the agents on this gateway, run and review their work, and manage them "
+        "- the same access as signing in."),
+}
+
+
+# --- store / provider access ------------------------------------------------------------------
+
+_stores: dict[str, devices.FleetDeviceStore] = {}
+_stores_lock = threading.Lock()
+
+
+def _state_dir() -> Path:
+    from hermes_constants import get_hermes_home
+    return Path(get_hermes_home()) / "dashboard_auth"
+
+
+def get_store() -> devices.FleetDeviceStore:
+    """One store per Hermes home (the dashboard can serve several profiles)."""
+    directory = _state_dir()
+    key = str(directory)
+    with _stores_lock:
+        store = _stores.get(key)
+        if store is None:
+            store = devices.FleetDeviceStore(directory / "fleet_devices.sqlite3")
+            _stores[key] = store
+        return store
+
+
+def ensure_provider_registered() -> FleetDeviceProvider:
+    """Register (or refresh) the hidden device-session provider. Called once the gate is engaged
+    and a real sign-in provider is already present, so it can never satisfy the
+    'gated dashboard needs a provider' startup check on its own."""
+    from hermes_cli.dashboard_auth.registry import get_provider, register_global_provider
+    existing = get_provider(PROVIDER_NAME)
+    store = get_store()
+    if isinstance(existing, FleetDeviceProvider) and existing.store is store:
+        return existing
+    provider = FleetDeviceProvider(store)
+    register_global_provider(provider)
+    return provider
+
+
+def _reset_for_tests() -> None:
+    with _stores_lock:
+        _stores.clear()
+    with _rate_lock:
+        _rate.clear()
+
+
+# --- rate limiting (best effort; resets on restart) ---------------------------------------------
+
+_RATE_MAX = 30
+_RATE_WINDOW = 60.0
+_RATE_MAX_BUCKETS = 4096
+_rate: OrderedDict[str, deque[float]] = OrderedDict()
+_rate_lock = threading.Lock()
+
+
+def _prune_rate_buckets_locked(cutoff: float) -> None:
+    """Drop expired pairing limiter buckets. Must hold ``_rate_lock``."""
+    for key in list(_rate):
+        bucket = _rate[key]
+        while bucket and bucket[0] < cutoff:
+            bucket.popleft()
+        if not bucket:
+            _rate.pop(key, None)
+
+
+def _rate_limited(bucket: str, ip: str) -> bool:
+    now = time.monotonic()
+    cutoff = now - _RATE_WINDOW
+    key = f"{bucket}:{ip or '_unknown_'}"
+    with _rate_lock:
+        max_buckets = max(1, int(_RATE_MAX_BUCKETS))
+        if key not in _rate and len(_rate) >= max_buckets:
+            _prune_rate_buckets_locked(cutoff)
+        while key not in _rate and len(_rate) >= max_buckets:
+            _rate.popitem(last=False)
+
+        window = _rate.get(key)
+        if window is None:
+            window = deque()
+            _rate[key] = window
+        else:
+            _rate.move_to_end(key)
+        while window and window[0] < now - _RATE_WINDOW:
+            window.popleft()
+        if len(window) >= _RATE_MAX:
+            return True
+        window.append(now)
+        return False
+
+
+# --- helpers ------------------------------------------------------------------------------------
+
+def _error(code: str, detail: str, status: Optional[int] = None) -> JSONResponse:
+    return JSONResponse(
+        {"error": code, "detail": detail},
+        status_code=status if status is not None else _STATUS_FOR_CODE.get(code, 400),
+        headers=_NO_STORE)
+
+
+def _pairing_available(request: Request) -> bool:
+    return bool(getattr(request.app.state, "auth_required", False))
+
+
+def _unavailable() -> JSONResponse:
+    return _error("pairing_unavailable",
+                  "Device pairing needs this gateway to require sign-in.", 409)
+
+
+def _is_dns_name(host: str) -> bool:
+    """A real DNS name: not an IP literal, not localhost, not single-label (so a publicly trusted
+    certificate can exist for it)."""
+    host = host.strip().lower().rstrip(".")
+    if not host or host == "localhost" or host.endswith(".localhost") or "." not in host:
+        return False
+    try:
+        ipaddress.ip_address(host.strip("[]"))
+        return False
+    except ValueError:
+        return True
+
+
+def _normalised_origin(raw: str) -> Optional[str]:
+    """``https://host[:port]`` or ``None``. Rejects userinfo, paths, queries, non-https, bad hosts."""
+    try:
+        parsed = urlparse(raw.strip())
+        host = parsed.hostname or ""
+        port = parsed.port
+    except ValueError:
+        return None
+    if parsed.scheme.lower() != "https" or not _is_dns_name(host):
+        return None
+    if parsed.username is not None or parsed.password is not None:
+        return None
+    if parsed.path not in ("", "/") or parsed.params or parsed.query or parsed.fragment:
+        return None
+    authority = host.lower() + (f":{port}" if port not in (None, 443) else "")
+    return f"https://{authority}"
+
+
+def _request_origin(request: Request) -> Optional[str]:
+    """The https origin the caller reached us on (the Host header, already validated by the
+    dashboard's host-header middleware)."""
+    return _normalised_origin(f"https://{request.headers.get('host', '')}")
+
+
+def _require_https(request: Request) -> Optional[JSONResponse]:
+    """Reject secret-bearing pairing traffic unless the trusted request scheme is HTTPS."""
+    if detect_https(request):
+        return None
+    return _error("https_required", "Device pairing requires an HTTPS connection.", 426)
+
+
+def _issuing_origin(request: Request) -> Optional[str]:
+    """Origin to embed in a new invitation: the operator-declared public URL, else the origin the
+    owner is using right now. ``None`` when neither is a usable https DNS origin."""
+    if not detect_https(request):
+        return None
+    configured = resolve_public_url()
+    if configured:
+        return _normalised_origin(configured)
+    return _request_origin(request)
+
+
+def _dashboard_settings() -> dict:
+    """Pairing presentation settings from the profile-scoped config loader."""
+    from hermes_cli.config import load_config
+
+    config = load_config()
+    section = config.get("dashboard") if isinstance(config, dict) else None
+    return section if isinstance(section, dict) else {}
+
+
+def _display_name(origin: str) -> str:
+    configured = _dashboard_settings().get("pairing_display_name", "")
+    configured = configured.strip() if isinstance(configured, str) else ""
+    if configured:
+        return "".join(ch for ch in configured if ch.isprintable())[:64]
+    host = urlparse(origin).hostname or "Hermes"
+    return host.split(".")[0][:64] or "Hermes"
+
+
+def _gateway_identity(origin: str) -> dict[str, str]:
+    return {
+        "instance_id": devices.get_instance_id(_state_dir()),
+        "display_name": _display_name(origin),
+        "origin": origin,
+    }
+
+
+def _owner_session(request: Request):
+    """The verified interactive (non-device) session, or an error response."""
+    session = getattr(request.state, "session", None)
+    if session is None:
+        return None, _error("unauthenticated", "Sign in required.", 401)
+    if getattr(session, "provider", "") == PROVIDER_NAME:
+        return None, _error("owner_required",
+                            "A paired device cannot manage pairing.", 403)
+    return session, None
+
+
+def _audit(event: AuditEvent, request: Request, **fields: Any) -> None:
+    audit_log(event, **fields, ip=client_ip(request))
+
+
+def _short(identifier: str) -> str:
+    return identifier[:8] if isinstance(identifier, str) else ""
+
+
+def _invitation_json(invitation: devices.Invitation) -> dict[str, Any]:
+    return {
+        "id": invitation.id, "label": invitation.label, "scopes": list(invitation.scopes),
+        "created_at": invitation.created_at, "expires_at": invitation.expires_at,
+        "origin": invitation.origin}
+
+
+def _device_json(device: devices.Device) -> dict[str, Any]:
+    return {
+        "id": device.id, "label": device.label, "device_model": device.device_model,
+        "scopes": list(device.scopes), "created_at": device.created_at,
+        "last_used_at": device.last_used_at, "revoked_at": device.revoked_at}
+
+
+# --- request bodies ---------------------------------------------------------------------------
+
+class _CreateInvitation(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+    label: str = Field(default="", max_length=64)
+    ttl_seconds: Optional[int] = Field(default=None, ge=1, le=86400)
+
+
+class _InvitationProof(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+    invitation_id: str = Field(max_length=64)
+    secret: str = Field(max_length=128)
+
+
+class _Redeem(_InvitationProof):
+    device_name: str = Field(default="", max_length=64)
+    device_model: str = Field(default="", max_length=64)
+
+
+class _Credential(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+    device_credential: str = Field(max_length=200)
+
+
+# --- owner routes -----------------------------------------------------------------------------
+
+@router.post("/api/fleet/pairing/invitations", name="fleet_pairing_create")
+async def create_invitation(request: Request, body: _CreateInvitation):
+    if not _pairing_available(request):
+        return _unavailable()
+    https_failure = _require_https(request)
+    if https_failure is not None:
+        return https_failure
+    session, failure = _owner_session(request)
+    if failure is not None:
+        return failure
+    origin = _issuing_origin(request)
+    if origin is None:
+        return _error(
+            "unsupported_public_url",
+            "Pairing links need an https address on a real hostname. Set dashboard.public_url "
+            "to the gateway's https origin (no path).", 409)
+    try:
+        issued = get_store().create_invitation(
+            origin=origin, created_by=session.user_id, label=body.label,
+            ttl_seconds=body.ttl_seconds)
+    except devices.PairingError as error:
+        return _error(error.code, "Could not create an invitation.")
+    invitation = issued.invitation
+    link = f"{origin}/pair#v=1&i={invitation.id}&s={issued.secret}"
+    _audit(AuditEvent.PAIRING_INVITATION_CREATED, request,
+           user_id=session.user_id, invitation=_short(invitation.id),
+           expires_at=invitation.expires_at)
+    payload = _invitation_json(invitation)
+    payload.update({
+        "secret": issued.secret,
+        "link": link,
+        "gateway": _gateway_identity(origin),
+        "ttl_seconds": invitation.expires_at - invitation.created_at,
+    })
+    return JSONResponse(payload, status_code=201, headers=_NO_STORE)
+
+
+@router.get("/api/fleet/pairing/invitations", name="fleet_pairing_list")
+async def list_invitations(request: Request):
+    if not _pairing_available(request):
+        return _unavailable()
+    _session, failure = _owner_session(request)
+    if failure is not None:
+        return failure
+    pending = get_store().list_pending_invitations()
+    return JSONResponse({"invitations": [_invitation_json(i) for i in pending]}, headers=_NO_STORE)
+
+
+@router.delete("/api/fleet/pairing/invitations/{invitation_id}", name="fleet_pairing_cancel")
+async def cancel_invitation(request: Request, invitation_id: str):
+    if not _pairing_available(request):
+        return _unavailable()
+    session, failure = _owner_session(request)
+    if failure is not None:
+        return failure
+    if not get_store().cancel_invitation(invitation_id):
+        return _error("invalid", "No such pending invitation.", 404)
+    _audit(AuditEvent.PAIRING_INVITATION_CANCELLED, request,
+           user_id=session.user_id, invitation=_short(invitation_id))
+    return JSONResponse({"ok": True}, headers=_NO_STORE)
+
+
+@router.get("/api/fleet/devices", name="fleet_devices_list")
+async def list_devices(request: Request):
+    if not _pairing_available(request):
+        return _unavailable()
+    _session, failure = _owner_session(request)
+    if failure is not None:
+        return failure
+    listed = get_store().list_devices()
+    return JSONResponse({"devices": [_device_json(d) for d in listed]}, headers=_NO_STORE)
+
+
+@router.delete("/api/fleet/devices/{device_id}", name="fleet_devices_revoke")
+async def revoke_device(request: Request, device_id: str):
+    if not _pairing_available(request):
+        return _unavailable()
+    session, failure = _owner_session(request)
+    if failure is not None:
+        return failure
+    if not get_store().revoke_device(device_id):
+        return _error("invalid", "No such device.", 404)
+    _audit(AuditEvent.DEVICE_REVOKED, request, user_id=session.user_id,
+           device=_short(device_id), by="owner")
+    return JSONResponse({"ok": True}, headers=_NO_STORE)
+
+
+# --- public, secret-authenticated routes ----------------------------------------------------------
+
+def _pairing_failure(request: Request, error: devices.PairingError, phase: str):
+    _audit(AuditEvent.PAIRING_FAILURE, request, phase=phase, reason=error.code)
+    return _error(error.code, "This pairing link cannot be used.")
+
+
+@router.post("/api/fleet/pairing/preview", name="fleet_pairing_preview")
+async def preview_invitation(request: Request, body: _InvitationProof):
+    """Inspect an invitation. NEVER consumes it and never grants access."""
+    if not _pairing_available(request):
+        return _unavailable()
+    https_failure = _require_https(request)
+    if https_failure is not None:
+        return https_failure
+    if _rate_limited("pairing", client_ip(request)):
+        return _error("rate_limited", "Too many attempts. Try again shortly.", 429)
+    origin = _request_origin(request)
+    if origin is None:
+        return _error("invalid", "This pairing link cannot be used.", 404)
+    store = get_store()
+    try:
+        invitation = store.preview(
+            invitation_id=body.invitation_id, secret=body.secret, origin=origin)
+    except devices.PairingError as error:
+        return _pairing_failure(request, error, "preview")
+    _audit(AuditEvent.PAIRING_PREVIEWED, request, invitation=_short(invitation.id))
+    return JSONResponse({
+        "gateway": _gateway_identity(origin),
+        "invitation": {
+            "id": invitation.id, "label": invitation.label,
+            "scopes": list(invitation.scopes), "expires_at": invitation.expires_at,
+            "server_time": int(time.time())},
+        "access": [{"scope": s, "summary": SCOPE_SUMMARIES.get(s, "")} for s in invitation.scopes],
+    }, headers=_NO_STORE)
+
+
+@router.post("/api/fleet/pairing/redeem", name="fleet_pairing_redeem")
+async def redeem_invitation(request: Request, body: _Redeem):
+    """Consume the invitation (exactly once) and return the device credential."""
+    if not _pairing_available(request):
+        return _unavailable()
+    https_failure = _require_https(request)
+    if https_failure is not None:
+        return https_failure
+    if _rate_limited("pairing", client_ip(request)):
+        return _error("rate_limited", "Too many attempts. Try again shortly.", 429)
+    origin = _request_origin(request)
+    if origin is None:
+        return _error("invalid", "This pairing link cannot be used.", 404)
+    try:
+        redeemed = get_store().redeem(
+            invitation_id=body.invitation_id, secret=body.secret,
+            device_name=body.device_name, device_model=body.device_model, origin=origin)
+    except devices.PairingError as error:
+        return _pairing_failure(request, error, "redeem")
+    device = redeemed.device
+    _audit(AuditEvent.PAIRING_REDEEMED, request, invitation=_short(body.invitation_id),
+           device=_short(device.id))
+    return JSONResponse({
+        "device": {"id": device.id, "label": device.label},
+        "credential": redeemed.credential,
+        "gateway": _gateway_identity(origin),
+        "scopes": list(device.scopes),
+    }, status_code=201, headers=_NO_STORE)
+
+
+@router.post("/auth/device-login", name="auth_device_login")
+async def device_login(request: Request, body: _Credential):
+    """Exchange a device credential for a short-lived session; sets the usual session cookie."""
+    if not _pairing_available(request):
+        return _unavailable()
+    https_failure = _require_https(request)
+    if https_failure is not None:
+        return https_failure
+    if _rate_limited("device-login", client_ip(request)):
+        return _error("rate_limited", "Too many attempts. Try again shortly.", 429)
+    store = get_store()
+    try:
+        device_session = store.open_session(body.device_credential)
+    except devices.PairingError:
+        _audit(AuditEvent.DEVICE_LOGIN_FAILURE, request, reason="invalid_credential")
+        return _error("invalid_credential", "This device is not signed in.", 401)
+    provider = ensure_provider_registered()
+    session = provider.session_for(device_session)
+    response = JSONResponse(
+        {"ok": True, "device_id": device_session.device_id, "expires_at": session.expires_at},
+        headers=_NO_STORE)
+    set_session_cookies(
+        response, access_token=session.access_token, refresh_token="",
+        access_token_expires_in=access_token_max_age(session), use_https=detect_https(request),
+        prefix=prefix_from_request(request), provider=session.provider)
+    _audit(AuditEvent.DEVICE_LOGIN, request, device=_short(device_session.device_id))
+    return response
+
+
+@router.post("/auth/device-revoke", name="auth_device_revoke")
+async def device_revoke(request: Request, body: _Credential):
+    """A device revokes itself (used when the user removes the gateway from the phone)."""
+    if not _pairing_available(request):
+        return _unavailable()
+    https_failure = _require_https(request)
+    if https_failure is not None:
+        return https_failure
+    if _rate_limited("device-login", client_ip(request)):
+        return _error("rate_limited", "Too many attempts. Try again shortly.", 429)
+    store = get_store()
+    device = store.verify_credential(body.device_credential)
+    if device is None or not store.revoke_device(device.id):
+        return _error("invalid_credential", "This device is not signed in.", 401)
+    _audit(AuditEvent.DEVICE_REVOKED, request, device=_short(device.id), by="device")
+    return JSONResponse({"ok": True}, headers=_NO_STORE)
+
+
+# --- static, secret-free pages --------------------------------------------------------------------
+
+_LANDING_CSP = ("default-src 'none'; style-src 'unsafe-inline'; script-src 'nonce-{nonce}'; "
+                "base-uri 'none'; form-action 'none'; frame-ancestors 'none'")
+
+
+@router.get("/pair", name="fleet_pairing_landing", response_class=HTMLResponse)
+async def pairing_landing(request: Request):
+    """What a person sees if a pairing link opens in a browser instead of the app. The invitation
+    lives in the URL FRAGMENT, which the browser never sends to any server, and this page does
+    not read it for any purpose other than letting the person copy the link."""
+    https_failure = _require_https(request)
+    if https_failure is not None:
+        return https_failure
+    nonce = secrets.token_urlsafe(16)
+    body = f"""<!doctype html><html lang="en"><head><meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<meta name="referrer" content="no-referrer"><title>Add this gateway to Hermes Fleet</title>
+<style>body{{font:16px -apple-system,system-ui,sans-serif;margin:2rem auto;max-width:34rem;padding:0 1rem;color:#222}}
+button{{font:inherit;padding:.6rem 1rem}}code{{word-break:break-all}}</style></head><body>
+<h1>Add this gateway to Hermes Fleet</h1>
+<p>Open this page on the iPhone that has <strong>Hermes Fleet</strong> installed. If the app did
+not open by itself, choose <strong>Add to Fleet &rarr; Paste pairing link</strong> in the app and paste this
+page's address.</p>
+<p>The pairing link works once, expires within minutes, and you will be asked to confirm before
+anything is added. Never share it.</p>
+<p><button id="copy" type="button">Copy link</button> <span id="status" role="status"></span></p>
+<script nonce="{html.escape(nonce, quote=True)}">
+document.getElementById("copy").addEventListener("click", function () {{
+  var s = document.getElementById("status");
+  (navigator.clipboard ? navigator.clipboard.writeText(location.href) : Promise.reject())
+    .then(function () {{ s.textContent = "Copied."; }},
+          function () {{ s.textContent = "Copy the address from your browser."; }});
+}});
+</script></body></html>"""
+    headers = dict(_NO_STORE)
+    headers.update({
+        "Content-Security-Policy": _LANDING_CSP.format(nonce=nonce),
+        "Referrer-Policy": "no-referrer",
+        "X-Content-Type-Options": "nosniff",
+    })
+    return HTMLResponse(body, headers=headers)
+
+
+def _configured_app_ids() -> list[str]:
+    raw = _dashboard_settings().get("pairing_app_ids", [])
+    if not isinstance(raw, list):
+        return []
+    ids = []
+    for value in raw:
+        part = value.strip() if isinstance(value, str) else ""
+        # "<TEAMID>.<bundle id>": ten alphanumerics, a dot, then a reverse-DNS bundle id.
+        if len(part) > 11 and part[10] == "." and part[:10].isalnum() and all(
+            ch.isalnum() or ch in ".-" for ch in part[11:]):
+            ids.append(part)
+    return ids
+
+
+@router.get("/.well-known/apple-app-site-association", name="fleet_pairing_aasa")
+async def apple_app_site_association(request: Request):
+    """Universal Links association. Served only when the operator lists the app ids to associate
+    in ``dashboard.pairing_app_ids``; the path/fragment are restricted to pairing links."""
+    app_ids = _configured_app_ids()
+    if not _pairing_available(request) or not app_ids:
+        return JSONResponse({"detail": "Not found"}, status_code=404)
+    document = {"applinks": {"details": [{
+        "appIDs": app_ids,
+        "components": [{"/": "/pair", "#": "v=1*", "comment": "Hermes Fleet pairing"}],
+    }]}}
+    return JSONResponse(document, headers={"Cache-Control": "public, max-age=300"})

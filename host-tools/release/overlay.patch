+"""Host-side Fleet pairing CLI."""
+from __future__ import annotations
+
+import io
+import os
+import tempfile
+import unittest
+
+_BOOT = tempfile.mkdtemp(prefix="hermes-fleet-cli-boot-")
+os.environ["HERMES_HOME"] = _BOOT
+
+from hermes_cli import fleet_pairing_cli as cli
+from hermes_cli.dashboard_auth import fleet_pairing_routes as routes
+
+
+class CliCase(unittest.TestCase):
+    def setUp(self) -> None:
+        self._tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self._tmp.cleanup)
+        self._saved = {k: os.environ.get(k) for k in ("HERMES_HOME", "HERMES_DASHBOARD_PUBLIC_URL")}
+        os.environ["HERMES_HOME"] = self._tmp.name
+        os.environ["HERMES_DASHBOARD_PUBLIC_URL"] = "https://gateway.example.test"
+        routes._reset_for_tests()
+        self.addCleanup(self._restore)
+
+    def _restore(self):
+        for key, value in self._saved.items():
+            if value is None:
+                os.environ.pop(key, None)
+            else:
+                os.environ[key] = value
+        routes._reset_for_tests()
+
+    def run_cli(self, *argv):
+        out = io.StringIO()
+        code = cli.main(list(argv), out=out)
+        return code, out.getvalue()
+
+    def test_invite_prints_a_working_link_once(self):
+        code, text = self.run_cli("invite", "--label", "Test phone", "--ttl", "120")
+        self.assertEqual(code, 0)
+        link = next(line for line in text.splitlines() if line.startswith("https://"))
+        self.assertTrue(link.startswith("https://gateway.example.test/pair#v=1&i="))
+        fragment = dict(part.split("=", 1) for part in link.split("#", 1)[1].split("&"))
+        store = routes.get_store()
+        redeemed = store.redeem(invitation_id=fragment["i"], secret=fragment["s"],
+                                origin="https://gateway.example.test")
+        self.assertTrue(redeemed.credential)
+        code, listing = self.run_cli("devices")
+        self.assertIn(redeemed.device.id, listing)
+        code, text = self.run_cli("revoke", redeemed.device.id)
+        self.assertEqual((code, text.strip()), (0, "revoked"))
+        self.assertIsNone(store.verify_credential(redeemed.credential))
+
+    def test_invite_refuses_without_an_https_public_url(self):
+        os.environ["HERMES_DASHBOARD_PUBLIC_URL"] = "http://gateway.example.test"
+        code, text = self.run_cli("invite")
+        self.assertEqual(code, 2)
+        self.assertEqual(text, "")
+
+    def test_cancel_and_list(self):
+        _code, text = self.run_cli("invite")
+        invitation_id = next(l for l in text.splitlines() if l.startswith("Invitation id")).split(": ")[1]
+        self.assertIn(invitation_id, self.run_cli("invitations")[1])
+        self.assertEqual(self.run_cli("cancel", invitation_id)[0], 0)
+        self.assertEqual(self.run_cli("invitations")[1], "")
+        self.assertEqual(self.run_cli("cancel", invitation_id)[0], 1)
+
+
+if __name__ == "__main__":
+    unittest.main()

@@ -0,0 +1,148 @@
+"""Hermes Fleet device pairing over a REAL TLS connection to the real dashboard under uvicorn.
+
+Unlike the TestClient suite this crosses an actual socket with certificate verification ON (the
+client trusts exactly the throwaway certificate the dev gateway generated, nothing else), so it
+covers TLS, separate connections, genuine concurrency and the WebSocket ticket handshake.
+"""
+from __future__ import annotations
+
+import os
+import sys
+import tempfile
+import threading
+import unittest
+from pathlib import Path
+
+# Never let importing the dashboard app read or write a developer's real Hermes home.
+os.environ["HERMES_HOME"] = tempfile.mkdtemp(prefix="hermes-fleet-pairing-net-boot-")
+
+import httpx
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "scripts"))
+from fleet_pairing_dev_server import DevServer
+
+
+class NetworkPairing(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls) -> None:
+        cls.server = DevServer().start()
+
+    @classmethod
+    def tearDownClass(cls) -> None:
+        cls.server.stop()
+
+    def setUp(self) -> None:
+        self.server.configure()   # other suites in this process may have cleared global state
+
+    def http(self) -> httpx.Client:
+        return httpx.Client(base_url=self.server.origin, verify=str(self.server.cert), timeout=20)
+
+    def owner(self) -> httpx.Client:
+        client = self.http()
+        r = client.post("/auth/password-login", json={
+            "provider": "owner", "username": "owner", "password": self.server.owner_password})
+        self.assertEqual(r.status_code, 200, r.text)
+        return client
+
+    def invite(self, owner: httpx.Client) -> dict:
+        r = owner.post("/api/fleet/pairing/invitations", json={"label": "network test"})
+        self.assertEqual(r.status_code, 201, r.text)
+        return r.json()
+
+    def test_certificate_verification_is_really_on(self):
+        # Without trusting the throwaway certificate the very same request must fail.
+        with self.assertRaises(httpx.ConnectError):
+            httpx.get(self.server.origin + "/pair", timeout=10)
+
+    def test_full_flow_over_tls(self):
+        owner = self.owner()
+        data = self.invite(owner)
+        self.assertTrue(data["link"].startswith(self.server.origin + "/pair#v=1&i="))
+        anon = self.http()
+        proof = {"invitation_id": data["id"], "secret": data["secret"]}
+
+        preview = anon.post("/api/fleet/pairing/preview", json=proof)
+        self.assertEqual(preview.status_code, 200, preview.text)
+        self.assertEqual(preview.json()["gateway"]["origin"], self.server.origin)
+
+        redeemed = anon.post("/api/fleet/pairing/redeem", json={**proof, "device_name": "net"})
+        self.assertEqual(redeemed.status_code, 201, redeemed.text)
+        credential = redeemed.json()["credential"]
+        self.assertEqual(
+            anon.post("/api/fleet/pairing/redeem", json=proof).status_code, 409)
+
+        device = self.http()
+        self.assertEqual(
+            device.post("/auth/device-login", json={"device_credential": credential}).status_code,
+            200)
+        ticket = device.post("/api/auth/ws-ticket")
+        self.assertEqual(ticket.status_code, 200, ticket.text)
+        self.assertEqual(device.get("/api/auth/me").json()["provider"], "fleet-device")
+
+        device_id = owner.get("/api/fleet/devices").json()["devices"][0]["id"]
+        self.assertEqual(owner.delete(f"/api/fleet/devices/{device_id}").status_code, 200)
+        self.assertEqual(device.get("/api/auth/me").status_code, 401)
+
+    def test_simultaneous_redemptions_over_separate_connections_have_one_winner(self):
+        owner = self.owner()
+        data = self.invite(owner)
+        proof = {"invitation_id": data["id"], "secret": data["secret"]}
+        attempts = 16
+        barrier = threading.Barrier(attempts)
+        statuses = []
+        credentials = []
+        lock = threading.Lock()
+
+        def worker(index: int) -> None:
+            with self.http() as client:
+                barrier.wait()
+                r = client.post("/api/fleet/pairing/redeem",
+                                json={**proof, "device_name": f"racer-{index}"})
+            with lock:
+                statuses.append(r.status_code)
+                if r.status_code == 201:
+                    credentials.append(r.json()["credential"])
+
+        threads = [threading.Thread(target=worker, args=(i,)) for i in range(attempts)]
+        for t in threads:
+            t.start()
+        for t in threads:
+            t.join(timeout=60)
+        self.assertEqual(statuses.count(201), 1, statuses)
+        self.assertEqual(statuses.count(409), attempts - 1, statuses)
+        self.assertEqual(len(credentials), 1)
+
+    def test_websocket_ticket_is_accepted_for_a_paired_device_only(self):
+        import asyncio
+
+        import websockets
+
+        owner = self.owner()
+        data = self.invite(owner)
+        proof = {"invitation_id": data["id"], "secret": data["secret"]}
+        credential = self.http().post(
+            "/api/fleet/pairing/redeem", json=proof).json()["credential"]
+        device = self.http()
+        device.post("/auth/device-login", json={"device_credential": credential})
+        ticket = device.post("/api/auth/ws-ticket").json()["ticket"]
+
+        import ssl
+        context = ssl.create_default_context(cafile=str(self.server.cert))
+        url = f"wss://localhost:{self.server.port}/api/ws?ticket={ticket}"
+
+        async def connect(target: str) -> str:
+            try:
+                async with websockets.connect(target, ssl=context, open_timeout=15):
+                    return "open"
+            except Exception as error:
+                return type(error).__name__
+
+        self.assertEqual(asyncio.run(connect(url)), "open")
+        # The ticket is single-use: replaying it is refused.
+        self.assertNotEqual(asyncio.run(connect(url)), "open")
+        self.assertNotEqual(
+            asyncio.run(connect(f"wss://localhost:{self.server.port}/api/ws?ticket=bogus")), "open")
+
+
+if __name__ == "__main__":
+    unittest.main()

index 0000000000000000000000000000000000000000..5fc5b502bab84fc0b9c4410ca67fe588c3d0d3a9
--- /dev/null
+++ b/hermes_cli/dashboard_auth/fleet_device_provider.py
@@ -0,0 +1,70 @@
+"""Dashboard-auth provider for paired Hermes Fleet devices.
+
+A paired device holds a long-lived, revocable *device credential* (``hfd1.<id>.<secret>``). It
+exchanges that credential at ``POST /auth/device-login`` for a short-lived session access token
+(``hfa1.<id>.<secret>``) that the normal gate accepts as a cookie or as a native-app bearer, so
+every dashboard API and the WebSocket ticket mint work exactly as they do after a password login.
+
+The provider is *hidden*: it never appears on the login page or in ``/api/auth/providers`` (it has
+no interactive login), and its OAuth-shaped methods refuse. Revoking a device invalidates all of
+its sessions on the very next request because ``verify_session`` consults the store every time.
+"""
+from __future__ import annotations
+
+from typing import Optional
+
+from hermes_cli.dashboard_auth.base import (
+    DashboardAuthProvider, InvalidCodeError, LoginStart, RefreshExpiredError, Session)
+from hermes_cli.dashboard_auth.fleet_devices import FleetDeviceStore
+
+PROVIDER_NAME = "fleet-device"
+
+
+class FleetDeviceProvider(DashboardAuthProvider):
+    name = PROVIDER_NAME
+    display_name = "Paired Fleet device"
+    supports_password = False
+    # Not part of the service-token seam: device credentials are accepted only at
+    # /auth/device-login, never as a bearer on token-authable routes.
+    supports_token = False
+    supports_session = True
+    #: Not offered on the login page or in the providers listing.
+    hidden = True
+
+    def __init__(self, store: FleetDeviceStore) -> None:
+        self._store = store
+
+    @property
+    def store(self) -> FleetDeviceStore:
+        return self._store
+
+    # -- OAuth-shaped surface: there is no interactive login for a device ----------------------
+
+    def start_login(self, *, redirect_uri: str) -> LoginStart:
+        raise NotImplementedError("paired devices have no interactive login")
+
+    def complete_login(
+            self, *, code: str, state: str, code_verifier: str, redirect_uri: str) -> Session:
+        raise InvalidCodeError("paired devices have no interactive login")
+
+    # -- sessions ------------------------------------------------------------------------------
+
+    def session_for(self, device_session) -> Session:
+        return Session(
+            user_id=f"device:{device_session.device_id}", email="",
+            display_name=device_session.label, org_id="", provider=self.name,
+            expires_at=device_session.expires_at, access_token=device_session.access_token,
+            # No refresh cookie: the device re-authenticates with its credential. Keeping the
+            # long-lived secret out of browser-style cookies is deliberate.
+            refresh_token="")
+
+    def verify_session(self, *, access_token: str) -> Optional[Session]:
+        live = self._store.verify_session(access_token)
+        return self.session_for(live) if live is not None else None
+
+    def refresh_session(self, *, refresh_token: str) -> Session:
+        # A device holds no refresh token; anything presented here is foreign to this provider.
+        raise RefreshExpiredError("not a device refresh token")
+
+    def revoke_session(self, *, refresh_token: str) -> None:
+        return None

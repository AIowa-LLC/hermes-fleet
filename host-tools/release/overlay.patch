+        forward_origin={"user_id": "123456"},
+    )
+    seen = []
+    runner = _runner({"allow_admin_from": ["123456"]}, access=False)
+    runner._is_user_authorized_for_source = lambda checked_source: seen.append(checked_source) or False
+
+    access, pairing_owner = telegram_context_authority(event, source, runner)

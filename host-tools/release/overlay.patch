+"""Hermes Fleet device pairing through the REAL dashboard app and auth gate.
+
+Owner sign-in uses a small in-test password provider (the same harness shape as
+``test_dashboard_auth_password_login``); everything else - the gate, the cookie handling, the
+WebSocket-ticket mint, the audit log - is the production code path.
+"""
+from __future__ import annotations
+
+import base64
+import hashlib
+import hmac
+import json
+import os
+import tempfile
+import time
+import unittest
+from pathlib import Path
+from typing import Any, cast
+
+# Importing the dashboard app loads configuration. Point it at a throwaway home BEFORE that
+# happens so a test run can never read or write a developer's real Hermes home.
+_BOOT_HOME = tempfile.mkdtemp(prefix="hermes-fleet-pairing-boot-")
+os.environ["HERMES_HOME"] = _BOOT_HOME
+
+from fastapi.testclient import TestClient
+
+from hermes_cli import web_server
+from hermes_cli.dashboard_auth import (
+    DashboardAuthProvider, InvalidCredentialsError, Session, clear_providers, register_provider)
+from hermes_cli.dashboard_auth import fleet_pairing_routes as routes
+from hermes_cli.dashboard_auth.routes import _reset_password_rate_limit
+
+HOST = "gateway.example.test"
+ORIGIN = f"https://{HOST}"
+SECRET = b"owner-test-secret-1234567890"
+
+
+def _sign(sub: str, kind: str, ttl: int) -> str:
+    raw = json.dumps({"sub": sub, "kind": kind, "exp": int(time.time()) + ttl},
+                     separators=(",", ":")).encode()
+    return base64.urlsafe_b64encode(raw + hmac.new(SECRET, raw, hashlib.sha256).digest()).decode()
+
+
+def _unsign(token: str):
+    try:
+        blob = base64.urlsafe_b64decode(token.encode())
+        raw, sig = blob[:-32], blob[-32:]
+        if not hmac.compare_digest(sig, hmac.new(SECRET, raw, hashlib.sha256).digest()):
+            return None
+        return json.loads(raw)
+    except Exception:
+        return None
+
+
+class OwnerProvider(DashboardAuthProvider):
+    name = "testpw"
+    display_name = "Test Password"
+    supports_password = True
+
+    def start_login(self, *, redirect_uri):
+        raise NotImplementedError
+
+    def complete_login(self, **kwargs):
+        raise NotImplementedError
+
+    def complete_password_login(self, *, username, password):
+        if (username, password) != ("owner", "correct horse"):
+            raise InvalidCredentialsError("bad")
+        return Session(
+            user_id="owner", email="", display_name="owner", org_id="", provider=self.name,
+            expires_at=int(time.time()) + 3600, access_token=_sign("owner", "access", 3600),
+            refresh_token=_sign("owner", "refresh", 86400))
+
+    def verify_session(self, *, access_token):
+        p = _unsign(access_token)
+        if not p or p.get("kind") != "access" or p["exp"] <= time.time():
+            return None
+        return Session(
+            user_id=p["sub"], email="", display_name=p["sub"], org_id="", provider=self.name,
+            expires_at=p["exp"], access_token=access_token, refresh_token="")
+
+    def refresh_session(self, *, refresh_token):
+        from hermes_cli.dashboard_auth import RefreshExpiredError
+        raise RefreshExpiredError("no")
+
+    def revoke_session(self, *, refresh_token):
+        return None
+
+
+class PairingHttpCase(unittest.TestCase):
+    def setUp(self) -> None:
+        self._tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self._tmp.cleanup)
+        self.home = Path(self._tmp.name)
+        self._saved_env = {k: os.environ.get(k) for k in (
+            "HERMES_HOME", "HERMES_DASHBOARD_PUBLIC_URL")}
+        os.environ["HERMES_HOME"] = str(self.home)
+        os.environ.pop("HERMES_DASHBOARD_PUBLIC_URL", None)
+        from hermes_cli.config import atomic_config_write
+        atomic_config_write(self.home / "config.yaml", {
+            "dashboard": {"pairing_display_name": "Test Gateway", "pairing_app_ids": []}})
+        self.addCleanup(self._restore_env)
+        clear_providers()
+        register_provider(OwnerProvider())
+        routes._reset_for_tests()
+        routes.ensure_provider_registered()
+        _reset_password_rate_limit()
+        state = web_server.app.state
+        self._prev = (getattr(state, "bound_host", None), getattr(state, "bound_port", None),
+                      getattr(state, "auth_required", None))
+        state.bound_host, state.bound_port, state.auth_required = HOST, 443, True
+        self.addCleanup(self._restore_state)
+
+    def _restore_env(self):
+        for key, value in self._saved_env.items():
+            if value is None:
+                os.environ.pop(key, None)
+            else:
+                os.environ[key] = value
+
+    def _restore_state(self):
+        clear_providers()
+        routes._reset_for_tests()
+        state = web_server.app.state
+        state.bound_host, state.bound_port, state.auth_required = self._prev
+
+    # -- helpers -----------------------------------------------------------------------------
+
+    def client(self) -> TestClient:
+        return TestClient(web_server.app, base_url=ORIGIN)
+
+    def owner(self) -> TestClient:

diff --git a/scripts/fleet_pairing_dev_server.py b/scripts/fleet_pairing_dev_server.py
new file mode 100644
index 0000000000000000000000000000000000000000..9632a78a1cb8ba966a4894bb51ecffda1a1d8131
--- /dev/null
+++ b/scripts/fleet_pairing_dev_server.py
@@ -0,0 +1,211 @@
+#!/usr/bin/env python3
+"""Development-only gateway for exercising Hermes Fleet device pairing end to end.
+
+Boots the REAL dashboard app (auth gate, cookies, WebSocket-ticket mint, pairing routes) under
+uvicorn with TLS on a loopback port, with a throwaway ``HERMES_HOME`` and a throwaway owner login.
+It exists so a client (the Fleet app's test suite, or a person with curl) can run the whole
+pairing exchange against genuine server code. It is NOT a deployment path:
+
+* it binds 127.0.0.1 only and uses a certificate generated for this run;
+* it touches no real Hermes home, credential, tunnel or DNS;
+* the only deviation from production behaviour is that the "real hostname" policy for pairing
+  links is relaxed so ``localhost`` can be used (clearly printed on start).
+
+Usage::
+
+    python scripts/fleet_pairing_dev_server.py            # prints one JSON line, then serves
+    python scripts/fleet_pairing_dev_server.py --ttl 90   # shorter invitations
+
+Stop with SIGTERM/SIGINT. The JSON line contains the port, certificate path, owner login and a
+ready-made owner session cookie value.
+"""
+from __future__ import annotations
+
+import argparse
+import base64
+import binascii
+import hashlib
+import hmac
+import json
+import os
+import shutil
+import signal
+import subprocess
+import sys
+import tempfile
+import threading
+import time
+from pathlib import Path
+
+SECRET = os.urandom(24)
+OWNER_USER = "owner"
+
+
+def _sign(sub: str, kind: str, ttl: int) -> str:
+    raw = json.dumps({"sub": sub, "kind": kind, "exp": int(time.time()) + ttl},
+                     separators=(",", ":")).encode()
+    return base64.urlsafe_b64encode(raw + hmac.new(SECRET, raw, hashlib.sha256).digest()).decode()
+
+
+def _unsign(token: str):
+    try:
+        blob = base64.urlsafe_b64decode(token.encode())
+        raw, sig = blob[:-32], blob[-32:]
+        if not hmac.compare_digest(sig, hmac.new(SECRET, raw, hashlib.sha256).digest()):
+            return None
+        return json.loads(raw)
+    except (binascii.Error, TypeError, UnicodeDecodeError, ValueError):
+        return None
+
+
+def make_certificate(directory: Path) -> tuple:
+    """Self-signed ``localhost`` certificate valid for two days (generated per run)."""
+    cert, key = directory / "cert.pem", directory / "key.pem"
+    subprocess.run([
+        "openssl", "req", "-x509", "-newkey", "rsa:2048", "-nodes", "-keyout", str(key),
+        "-out", str(cert), "-days", "2", "-subj", "/CN=localhost",
+        "-addext", "subjectAltName=DNS:localhost,IP:127.0.0.1",
+        "-addext", "extendedKeyUsage=serverAuth", "-addext", "basicConstraints=CA:FALSE",
+    ], check=True, capture_output=True, timeout=60)
+    os.chmod(key, 0o600)
+    return cert, key
+
+
+class DevServer:
+    """Owns the temp home, certificate, owner password and the uvicorn thread."""
+
+    def __init__(self, *, ttl: int | None = None) -> None:
+        self.home = Path(tempfile.mkdtemp(prefix="hermes-fleet-dev-gateway-"))
+        os.environ["HERMES_HOME"] = str(self.home)      # BEFORE importing the app
+        os.environ.pop("HERMES_DASHBOARD_PUBLIC_URL", None)
+        from hermes_cli.config import atomic_config_write
+        atomic_config_write(self.home / "config.yaml", {
+            "dashboard": {"pairing_display_name": "Dev Gateway", "pairing_app_ids": []}})
+        self.owner_password = base64.urlsafe_b64encode(os.urandom(12)).decode()
+        self.cert, self.key = make_certificate(self.home)
+        self.ttl = ttl
+        self.port = 0
+        self._server = None
+        self._thread = None
+
+    def start(self) -> DevServer:
+        import uvicorn
+        from hermes_cli import web_server
+        from hermes_cli.dashboard_auth import (
+            DashboardAuthProvider, InvalidCredentialsError, RefreshExpiredError, Session,
+            clear_providers, register_provider)
+        from hermes_cli.dashboard_auth import fleet_pairing_routes as routes
+
+        expected_password = self.owner_password
+
+        class Owner(DashboardAuthProvider):
+            name = "owner"
+            display_name = "Owner"
+            supports_password = True
+
+            def start_login(self, *, redirect_uri):
+                raise NotImplementedError
+
+            def complete_login(self, **kwargs):
+                raise NotImplementedError
+
+            def complete_password_login(self, *, username, password):
+                ok = hmac.compare_digest(username, OWNER_USER) and hmac.compare_digest(
+                    password, expected_password)
+                if not ok:
+                    raise InvalidCredentialsError("bad")
+                return Session(
+                    user_id=OWNER_USER, email="", display_name=OWNER_USER, org_id="",
+                    provider=self.name, expires_at=int(time.time()) + 3600,
+                    access_token=_sign(OWNER_USER, "access", 3600),
+                    refresh_token=_sign(OWNER_USER, "refresh", 86400))
+
+            def verify_session(self, *, access_token):
+                claims = _unsign(access_token)
+                if not claims or claims.get("kind") != "access" or claims["exp"] <= time.time():
+                    return None
+                return Session(
+                    user_id=claims["sub"], email="", display_name=claims["sub"], org_id="",
+                    provider=self.name, expires_at=claims["exp"], access_token=access_token,
+                    refresh_token="")
+
+            def refresh_session(self, *, refresh_token):
+                raise RefreshExpiredError("no")
+
+            def revoke_session(self, *, refresh_token):
+                return None
+
+        self._owner_provider = Owner()
+        self._deps = (clear_providers, register_provider, routes, web_server)
+        self.configure()
+
+        config = uvicorn.Config(
+            web_server.app, host="127.0.0.1", port=0, ssl_certfile=str(self.cert),
+            ssl_keyfile=str(self.key), log_level="warning", lifespan="off")
+        self._server = uvicorn.Server(config)
+        self._thread = threading.Thread(target=self._server.run, daemon=True)
+        self._thread.start()
+        deadline = time.time() + 30
+        while time.time() < deadline:
+            if self._server.started and self._server.servers:
+                self.port = self._server.servers[0].sockets[0].getsockname()[1]
+                web_server.app.state.bound_port = self.port
+                return self
+            time.sleep(0.05)
+        raise RuntimeError("dev gateway did not start")
+
+    def configure(self) -> None:
+        """(Re)apply the process-global gateway state this server relies on (provider registry,
+        auth gate flags, harness-only hostname policy). Idempotent; tests that share a process
+        with others call it from ``setUp`` because those others may clear the registry."""
+        clear_providers, register_provider, routes, web_server = self._deps
+        clear_providers()
+        register_provider(self._owner_provider)
+        routes._reset_for_tests()
+        routes.ensure_provider_registered()
+        # Test-harness-only relaxation: allow a loopback hostname for pairing links.
+        routes._is_dns_name = lambda host: bool(host)
+        if self.ttl is not None:
+            import hermes_cli.dashboard_auth.fleet_devices as fd
+            fd.DEFAULT_TTL_SECONDS = max(fd.MIN_TTL_SECONDS, min(fd.MAX_TTL_SECONDS, self.ttl))
+        state = web_server.app.state
+        state.bound_host = "localhost"
+        state.auth_required = True
+        state.trusted_public_hosts = frozenset({"localhost"})
+        if self.port:
+            state.bound_port = self.port
+
+    @property
+    def origin(self) -> str:
+        return f"https://localhost:{self.port}"
+
+    def stop(self) -> None:
+        if self._server is not None:
+            self._server.should_exit = True
+        if self._thread is not None:
+            self._thread.join(timeout=15)
+        shutil.rmtree(self.home, ignore_errors=True)
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    parser.add_argument("--ttl", type=int, default=None, help="invitation lifetime in seconds")
+    args = parser.parse_args()
+    repo = Path(__file__).resolve().parents[1]
+    sys.path.insert(0, str(repo))
+    server = DevServer(ttl=args.ttl).start()
+    stop = threading.Event()
+    for sig in (signal.SIGTERM, signal.SIGINT):
+        signal.signal(sig, lambda *_: stop.set())
+    print(json.dumps({
+        "origin": server.origin, "port": server.port, "cert": str(server.cert),
+        "owner_user": OWNER_USER, "owner_password": server.owner_password,
+        "note": "loopback hostname allowed for pairing links (test harness only)",
+    }), flush=True)
+    stop.wait()
+    server.stop()
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

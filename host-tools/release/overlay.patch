+        r = c.post("/auth/password-login", json={
+            "provider": "testpw", "username": "owner", "password": "correct horse"})
+        self.assertEqual(r.status_code, 200, r.text)
+        return c
+
+    def invite(self, owner: TestClient, **body):
+        r = owner.post("/api/fleet/pairing/invitations", json=body)
+        self.assertEqual(r.status_code, 201, r.text)
+        return r.json()
+
+    def proof(self, data):
+        return {"invitation_id": data["id"], "secret": data["secret"]}
+
+    def redeem(self, data, client=None, **extra):
+        c = client or self.client()
+        return c.post("/api/fleet/pairing/redeem",
+                      json={**self.proof(data), "device_name": "Test iPhone", **extra})
+
+    def audit_log_text(self) -> str:
+        path = self.home / "logs" / "dashboard-auth.log"
+        return path.read_text(encoding="utf-8") if path.exists() else ""

+        self.assertFalse(any("hermes_session_rt" in c for c in r.headers.get_list("set-cookie")),
+                         "the long-lived credential must not be written to a refresh cookie")
+        me = device.get("/api/auth/me").json()
+        self.assertEqual(me["provider"], "fleet-device")
+        self.assertTrue(me["user_id"].startswith("device:"))
+        ticket = device.post("/api/auth/ws-ticket")
+        self.assertEqual(ticket.status_code, 200)
+        self.assertTrue(ticket.json()["ticket"])
+
+    def test_device_session_works_as_a_native_bearer_too(self):
+        _owner, _data, credential = self.paired()
+        login = self.client().post("/auth/device-login", json={"device_credential": credential})
+        cookie = next(c for c in login.headers.get_list("set-cookie") if "hermes_session_at" in c)
+        token = cookie.split("=", 1)[1].split(";", 1)[0]
+        bare = self.client()
+        r = bare.get("/api/auth/me", headers={"Authorization": f"Bearer {token}"})
+        self.assertEqual(r.status_code, 200, r.text)
+
+    def test_bad_credentials_are_refused_generically(self):
+        for bad in ("", "nope", "hfd1." + "a" * 32 + "." + "b" * 43):
+            r = self.client().post("/auth/device-login", json={"device_credential": bad})
+            self.assertEqual((r.status_code, r.json()["error"]), (401, "invalid_credential"))
+        self.assertNotIn("Set-Cookie", [k for k in r.headers.keys()])
+
+    def test_a_device_cannot_manage_pairing_or_other_devices(self):
+        owner, _data, credential = self.paired()
+        device = self.client()
+        device.post("/auth/device-login", json={"device_credential": credential})
+        self.assertEqual(device.post("/api/fleet/pairing/invitations", json={}).status_code, 403)
+        self.assertEqual(device.get("/api/fleet/pairing/invitations").status_code, 403)
+        self.assertEqual(device.get("/api/fleet/devices").status_code, 403)
+        device_id = owner.get("/api/fleet/devices").json()["devices"][0]["id"]
+        self.assertEqual(device.delete(f"/api/fleet/devices/{device_id}").status_code, 403)
+
+    def test_owner_revocation_cuts_off_live_sessions_immediately(self):
+        owner, _data, credential = self.paired()
+        device = self.client()
+        device.post("/auth/device-login", json={"device_credential": credential})
+        self.assertEqual(device.get("/api/auth/me").status_code, 200)
+        device_id = owner.get("/api/fleet/devices").json()["devices"][0]["id"]
+        self.assertEqual(owner.delete(f"/api/fleet/devices/{device_id}").status_code, 200)
+        self.assertEqual(device.get("/api/auth/me").status_code, 401)
+        self.assertEqual(device.post("/api/auth/ws-ticket").status_code, 401)
+        again = self.client().post("/auth/device-login", json={"device_credential": credential})
+        self.assertEqual(again.status_code, 401)
+        self.assertEqual(owner.get("/api/fleet/devices").json()["devices"], [])
+
+    def test_device_can_revoke_itself(self):
+        owner, _data, credential = self.paired()
+        r = self.client().post("/auth/device-revoke", json={"device_credential": credential})
+        self.assertEqual(r.status_code, 200)
+        self.assertEqual(owner.get("/api/fleet/devices").json()["devices"], [])
+        again = self.client().post("/auth/device-revoke", json={"device_credential": credential})
+        self.assertEqual(again.status_code, 401)
+
+    def test_each_invitation_makes_its_own_device(self):
+        owner = self.owner()
+        a = self.redeem(self.invite(owner)).json()
+        b = self.redeem(self.invite(owner)).json()
+        self.assertNotEqual(a["credential"], b["credential"])
+        self.assertNotEqual(a["device"]["id"], b["device"]["id"])
+        self.assertEqual(len(owner.get("/api/fleet/devices").json()["devices"]), 2)
+
+
+class HiddenProviderAndPages(PairingHttpCase):
+    def test_hidden_device_provider_cannot_be_selected_for_interactive_login(self):
+        client = TestClient(web_server.app, base_url=ORIGIN, raise_server_exceptions=False)
+        login = client.get("/auth/login", params={"provider": "fleet-device"})
+        self.assertEqual(login.status_code, 404)
+
+        native = client.get("/auth/native/authorize", params={
+            "provider": "fleet-device",
+            "code_challenge": "a" * 43,
+            "code_challenge_method": "S256",
+            "redirect_uri": "http://127.0.0.1:53999/callback",
+            "state": "device-login-selection",
+        })
+        self.assertEqual(native.status_code, 404)
+
+    def test_device_provider_is_never_offered_as_a_sign_in(self):
+        providers = self.client().get("/api/auth/providers").json()["providers"]
+        self.assertEqual([p["name"] for p in providers], ["testpw"])
+        login = self.client().get("/login")
+        self.assertNotIn("fleet-device", login.text)
+        self.assertNotIn("Paired Fleet device", login.text)
+
+    def test_landing_page_is_secret_free_and_locked_down(self):
+        r = self.client().get("/pair")
+        self.assertEqual(r.status_code, 200)
+        self.assertIn("no-store", r.headers["cache-control"])
+        csp = r.headers["content-security-policy"]
+        self.assertIn("default-src 'none'", csp)
+        self.assertIn("script-src 'nonce-", csp)
+        self.assertEqual(r.headers["referrer-policy"], "no-referrer")
+        self.assertIn("Add to Fleet", r.text)
+
+    def test_app_site_association_only_when_configured_and_wellformed(self):
+        self.assertEqual(self.client().get("/.well-known/apple-app-site-association").status_code, 404)
+        from hermes_cli.config import atomic_config_write
+        atomic_config_write(self.home / "config.yaml", {
+            "dashboard": {
+                "pairing_display_name": "Test Gateway",
+                "pairing_app_ids": ["ABCDE12345.com.example.fleet", "not-an-id", "../x"],
+            }})
+        r = self.client().get("/.well-known/apple-app-site-association")
+        self.assertEqual(r.status_code, 200)
+        detail = r.json()["applinks"]["details"][0]
+        self.assertEqual(detail["appIDs"], ["ABCDE12345.com.example.fleet"])
+        self.assertEqual(detail["components"][0]["/"], "/pair")
+
+
+class NoSecretsInLogs(PairingHttpCase):
+    def test_audit_log_contains_no_secret_credential_or_session_token(self):
+        owner = self.owner()
+        data = self.invite(owner)
+        self.client().post("/api/fleet/pairing/preview", json=self.proof(data))
+        self.client().post("/api/fleet/pairing/redeem", json={
+            "invitation_id": data["id"], "secret": "w" * 43})
+        redeemed = self.redeem(data).json()
+        self.redeem(data)  # replay
+        login = self.client().post("/auth/device-login",
+                                   json={"device_credential": redeemed["credential"]})
+        cookie = next(c for c in login.headers.get_list("set-cookie") if "hermes_session_at" in c)
+        session_token = cookie.split("=", 1)[1].split(";", 1)[0]
+        self.client().post("/auth/device-revoke", json={"device_credential": redeemed["credential"]})
+
+        log = self.audit_log_text()
+        self.assertIn("pairing_invitation_created", log)
+        self.assertIn("pairing_redeemed", log)
+        self.assertIn("device_login", log)
+        self.assertIn("device_revoked", log)
+        for forbidden in (
+            data["secret"], data["id"], redeemed["credential"],
+            redeemed["credential"].split(".")[2], session_token, "w" * 43,
+        ):
+            self.assertNotIn(forbidden, log)
+
+
+if __name__ == "__main__":
+    unittest.main()

@@ -0,0 +1,90 @@
+"""Host-side owner commands for Hermes Fleet device pairing.
+
+    python -m hermes_cli.fleet_pairing_cli invite [--label "Tony's iPhone"] [--ttl 600]
+    python -m hermes_cli.fleet_pairing_cli invitations
+    python -m hermes_cli.fleet_pairing_cli cancel <invitation-id>
+    python -m hermes_cli.fleet_pairing_cli devices
+    python -m hermes_cli.fleet_pairing_cli revoke <device-id>
+
+These act directly on this machine's pairing store, so they carry the authority of whoever can
+read the Hermes home - the same trust the dashboard owner login represents. The invitation link is
+printed once; it works once and expires, but treat it like a password until it has been used.
+The same operations are available over the authenticated dashboard API
+(``/api/fleet/pairing/invitations``, ``/api/fleet/devices``).
+"""
+from __future__ import annotations
+
+import argparse
+import sys
+import time
+from typing import Optional, Sequence
+
+from hermes_cli.dashboard_auth import fleet_devices as devices
+
+
+def _stamp(epoch: Optional[int]) -> str:
+    if not epoch:
+        return "never"
+    return time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(epoch))
+
+
+def main(argv: Optional[Sequence[str]] = None, *, out=None) -> int:
+    out = out or sys.stdout
+    parser = argparse.ArgumentParser(prog="fleet_pairing_cli", description=__doc__.splitlines()[0])
+    sub = parser.add_subparsers(dest="command", required=True)
+    invite = sub.add_parser("invite", help="create a short-lived single-use pairing link")
+    invite.add_argument("--label", default="", help="name shown on the phone and in the device list")
+    invite.add_argument("--ttl", type=int, default=None,
+                        help=f"seconds ({devices.MIN_TTL_SECONDS}-{devices.MAX_TTL_SECONDS}, "
+                             f"default {devices.DEFAULT_TTL_SECONDS})")
+    sub.add_parser("invitations", help="list pending invitations")
+    cancel = sub.add_parser("cancel", help="cancel a pending invitation")
+    cancel.add_argument("invitation_id")
+    sub.add_parser("devices", help="list paired devices")
+    revoke = sub.add_parser("revoke", help="revoke a paired device immediately")
+    revoke.add_argument("device_id")
+    args = parser.parse_args(argv)
+
+    # Imported lazily: these pull in the dashboard route module (and its config loading).
+    from hermes_cli.dashboard_auth import fleet_pairing_routes as routes
+    store = routes.get_store()
+
+    if args.command == "invite":
+        origin = routes._normalised_origin(routes.resolve_public_url() or "")
+        if origin is None:
+            print("error: set dashboard.public_url (or HERMES_DASHBOARD_PUBLIC_URL) to this "
+                  "gateway's https origin on a real hostname, with no path.", file=sys.stderr)
+            return 2
+        try:
+            issued = store.create_invitation(
+                origin=origin, created_by="host-cli", label=args.label, ttl_seconds=args.ttl)
+        except devices.PairingError as error:
+            print(f"error: {error.code}", file=sys.stderr)
+            return 1
+        inv = issued.invitation
+        print(f"Pairing link for {origin} (works once; expires {_stamp(inv.expires_at)}):", file=out)
+        print(f"{origin}/pair#v=1&i={inv.id}&s={issued.secret}", file=out)
+        print(f"Invitation id (to cancel): {inv.id}", file=out)
+        return 0
+    if args.command == "invitations":
+        for inv in store.list_pending_invitations():
+            print(f"{inv.id}  {inv.label}  expires {_stamp(inv.expires_at)}", file=out)
+        return 0
+    if args.command == "cancel":
+        ok = store.cancel_invitation(args.invitation_id)
+        print("cancelled" if ok else "no such pending invitation", file=out)
+        return 0 if ok else 1
+    if args.command == "devices":
+        for dev in store.list_devices():
+            print(f"{dev.id}  {dev.label}  paired {_stamp(dev.created_at)}  "
+                  f"last used {_stamp(dev.last_used_at)}", file=out)
+        return 0
+    if args.command == "revoke":
+        ok = store.revoke_device(args.device_id)
+        print("revoked" if ok else "no such device", file=out)
+        return 0 if ok else 1
+    return 2
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

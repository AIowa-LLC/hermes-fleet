+class OwnerIssuance(PairingHttpCase):
+    def test_trusted_proxy_https_supports_pairing_over_loopback_http_backend(self):
+        from uvicorn.middleware.proxy_headers import ProxyHeadersMiddleware
+
+        os.environ["HERMES_DASHBOARD_PUBLIC_URL"] = ORIGIN
+        app = ProxyHeadersMiddleware(cast(Any, web_server.app), trusted_hosts=["127.0.0.1", "::1"])
+        client = TestClient(
+            cast(Any, app), base_url=f"http://{HOST}", client=("127.0.0.1", 54321),
+            headers={"X-Forwarded-Proto": "https"})
+        login = client.post("/auth/password-login", json={
+            "provider": "testpw", "username": "owner", "password": "correct horse"})
+        self.assertEqual(login.status_code, 200, login.text)
+        owner_cookie = next(
+            (value for value in login.headers.get_list("set-cookie")
+             if value.startswith("__Host-hermes_session_at=")), "")
+        owner_token = owner_cookie.split("=", 1)[1].split(";", 1)[0] if owner_cookie else ""
+        self.assertTrue(owner_token)
+        # TestClient sees the backend's HTTP URL; the trusted proxy has already validated the
+        # public HTTPS hop and the cookie is sent by the browser on that external HTTPS origin.
+        client.cookies.clear()
+        client.cookies.set("hermes_session_at", owner_token, domain=HOST, path="/")
+
+        created = client.post("/api/fleet/pairing/invitations", json={})
+        self.assertEqual(created.status_code, 201, created.text)
+        data = created.json()
+        self.assertEqual(
+            client.post("/api/fleet/pairing/preview", json=self.proof(data)).status_code, 200)
+        redeemed = self.redeem(data, client=client)
+        self.assertEqual(redeemed.status_code, 201, redeemed.text)
+        credential = redeemed.json()["credential"]
+        device_login = client.post("/auth/device-login", json={"device_credential": credential})
+        self.assertEqual(device_login.status_code, 200, device_login.text)
+        self.assertTrue(any(
+            "hermes_session_at" in value and "secure" in value.lower()
+            for value in device_login.headers.get_list("set-cookie")))
+        self.assertEqual(
+            client.post("/auth/device-revoke", json={"device_credential": credential}).status_code,
+            200)
+        self.assertEqual(client.get("/pair").status_code, 200)
+
+    def test_insecure_http_rejects_secret_bearing_pairing_surfaces(self):

diff --git a/gateway/session_context_security.py b/gateway/session_context_security.py
new file mode 100644
index 0000000000000000000000000000000000000000..de1162587d5029c3efc13611ff08c01fc99a7936
--- /dev/null
+++ b/gateway/session_context_security.py
@@ -0,0 +1,62 @@
+"""Turn-scoped Telegram transport and explicit admin trust for Fleet pairing."""
+
+import logging
+from typing import Any, Optional
+
+from gateway.config import Platform
+
+logger = logging.getLogger("gateway.session")
+
+
+def _configured_pairing_owner_ids(runner: Any, source: Any) -> Optional[frozenset[str]]:
+    """Explicit, profile-scoped Fleet-pairing owner IDs; ``None`` means no binding is configured."""
+    from gateway.slash_access import platform_extra_for_runner_source
+
+    extra = platform_extra_for_runner_source(runner, source)
+    if extra is None or "fleet_pairing_owner_user_ids" not in extra:
+        return None
+    raw = extra.get("fleet_pairing_owner_user_ids")
+    values = raw if isinstance(raw, (list, tuple, set, frozenset)) else (raw,)
+    return frozenset(
+        user_id for value in values
+        if not isinstance(value, bool)
+        and (user_id := str(value).strip()).isdecimal()
+    )
+
+
+def telegram_context_authority(event: Any, source: Any, runner: Any) -> tuple[Optional[bool], Optional[bool]]:
+    """Return (ordinary gateway access, Fleet-pairing owner binding) from trusted gateway state.
+
+    Fleet ownership is a separate, profile-scoped binding to explicit numeric Telegram user IDs;
+    slash-command ``allow_admin_from``, chat allowlists, names, message text, forwarded content, and
+    source dictionaries never grant it.
+    """
+    if getattr(event, "internal", False) or getattr(source, "platform", None) != Platform.TELEGRAM:
+        return None, None
+    authorize = getattr(runner, "_is_user_authorized_for_source", None)
+    if not callable(authorize):
+        return None, None
+    try:
+        access = authorize(source)
+    except Exception:  # health: allow BLE001 -- fail closed without logging auth exception data
+        logger.warning("Telegram access context unavailable; privileged actions will fail closed")
+        return None, None
+    if access is not True and access is not False:
+        return None, None
+    if access is False:
+        return False, False
+
+    user_id = str(getattr(source, "user_id", None) or "").strip()
+    chat_id = str(getattr(source, "chat_id", None) or "").strip()
+    if (getattr(source, "chat_type", None) != "dm" or not user_id or not chat_id
+            or user_id != chat_id):
+        return True, False
+
+    try:
+        owner_ids = _configured_pairing_owner_ids(runner, source)
+    except Exception:  # health: allow BLE001 -- fail closed without logging auth exception data
+        logger.warning("Telegram Fleet owner binding unavailable; privileged actions will fail closed")
+        return True, None
+    if owner_ids is None:
+        return True, None
+    return True, user_id in owner_ids
